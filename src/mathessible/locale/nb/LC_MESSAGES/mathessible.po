msgid "PDF/UA requires every equation to be readable, and one could not be: export as Tagged PDF."
msgstr "PDF/UA krever at hver likning er lesbar, og én er det ikke: eksporter som merket PDF."

#: src/mathessible/error_messages.py:16
msgid "PDF/A-2 does not allow attachments: choose PDF/A-3a, or do not attach the source."
msgstr "PDF/A-2 tillater ikke vedlegg: velg PDF/A-3a, eller ikke legg ved kilden."

#: src/mathessible/error_messages.py:17
msgid "A font is not installed: choose another in the export's Layout tab."
msgstr "En skrift er ikke installert: velg en annen i fanen Oppsett i eksporten."

#: src/mathessible/error_messages.py:25
msgid ""
"Mathessible is not allowed to use this file or folder. Choose another place, or check its "
"permissions."
msgstr ""
"Mathessible har ikke lov til å bruke denne filen eller mappen. Velg et annet sted, eller sjekk "
"tillatelsene."

#: src/mathessible/error_messages.py:28
msgid "The file or folder is not there any more."
msgstr "Filen eller mappen finnes ikke lenger."

#: src/mathessible/error_messages.py:30
msgid "That is a folder, not a file."
msgstr "Det er en mappe, ikke en fil."

#: src/mathessible/error_messages.py:32
msgid "The disk is full."
msgstr "Disken er full."

#: src/mathessible/error_messages.py:34
msgid "The file is not text in UTF-8, so Mathessible cannot read it."
msgstr "Filen er ikke tekst i UTF-8, så Mathessible kan ikke lese den."

#: src/mathessible/error_messages.py:36
msgid "Mathessible's native part (MathCAT and liblouis) is missing. Run scripts/bootstrap.sh."
msgstr "Den opprinnelige delen av Mathessible (MathCAT og liblouis) mangler. Kjør scripts/bootstrap.sh."

#: src/mathessible/error_messages.py:43
#, python-brace-format
msgid "Typst could not typeset the PDF: {error}"
msgstr "Typst kunne ikke sette PDF-en: {error}"

#: src/mathessible/error_messages.py:45
msgid "The braille table could not be loaded. Choose another in the export's dialog."
msgstr "Punktskrifttabellen kunne ikke lastes inn. Velg en annen i dialogboksen for eksporten."

