msgstr "Navigasi linear di mode jelajah"

#: src/mathessible/ui/settings_dialog.py:273
msgid ""
"Stop at the start and end of every structure (for example \"start fraction\", \"end numerator\") "
"and of the math"
msgstr ""
"Berhenti di awal dan akhir setiap struktur (misalnya \"mulai pecahan\", \"selesai pembilang\") "
"dan matematika"

