msgstr "Pobieranie listy języków NVDA…"

#: src/mathessible/ui/settings_dialog.py:718
msgid "Choose the languages to download (Space checks one)."
msgstr "Wybierz języki do pobrania (spacja zaznacza jeden)."

#: src/mathessible/ui/settings_dialog.py:719 src/mathessible/ui/settings_dialog.py:752
#: src/mathessible/ui/settings_dialog.py:757 src/mathessible/ui/settings_dialog.py:778
msgid "Download NVDA dictionaries"
msgstr "Pobierz słowniki NVDA"

