msgid "Build equations as you type"
msgstr "Buduj równania podczas pisania"

#: src/mathessible/ui/settings_dialog.py:183
msgid "Say what was built while typing (for example, built fraction)"
msgstr "Mów, co zbudowano podczas pisania (na przykład zbudowano: ułamek)"

