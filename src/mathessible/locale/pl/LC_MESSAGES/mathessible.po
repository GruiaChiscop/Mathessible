msgid "Stop at structure start and end"
msgstr "Zatrzymuj się na początku i końcu struktur"

#: src/mathessible/ui/settings_dialog.py:228
msgid "Stop at invisible operators (for example the invisible times in 3x)"
msgstr "Zatrzymuj się na niewidocznych operatorach (na przykład niewidocznym mnożeniu w 3x)"

#: src/mathessible/ui/settings_dialog.py:229
msgid "Stop at invisible operators"
msgstr "Zatrzymuj się na niewidocznych operatorach"

#: src/mathessible/ui/settings_dialog.py:234
msgid "Leave a structure automatically at its end (for example, from the numerator to the denominator)"
msgstr "Opuszczaj strukturę automatycznie na jej końcu (na przykład z licznika do mianownika)"

#: src/mathessible/ui/settings_dialog.py:235
msgid "Leave structures automatically"
msgstr "Opuszczaj struktury automatycznie"

#: src/mathessible/ui/settings_dialog.py:241
msgid ""
"When enabled, the right arrow enters structures such as fractions automatically, so you can read "
"more of an expression without pressing Down."
msgstr ""
"Gdy ta opcja jest włączona, strzałka w prawo automatycznie wchodzi do struktur takich jak ułamki,"
" więc można przeczytać więcej wyrażenia bez naciskania strzałki w dół."

