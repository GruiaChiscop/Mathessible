#: src/mathessible/error_messages.py:11
msgid "PDF/UA requires a title: give one in the export's Document tab."
msgstr "PDF/UA yêu cầu có tiêu đề: hãy nhập tiêu đề trong thẻ Tài liệu của phần xuất."

#: src/mathessible/error_messages.py:14
msgid "PDF/UA requires every equation to be readable, and one could not be: export as Tagged PDF."
msgstr ""
"PDF/UA yêu cầu mọi phương trình đều đọc được, nhưng có một phương trình không đọc được: hãy xuất "
"dưới dạng PDF có gắn thẻ."

#: src/mathessible/error_messages.py:16
msgid "PDF/A-2 does not allow attachments: choose PDF/A-3a, or do not attach the source."
msgstr "PDF/A-2 không cho phép tệp đính kèm: hãy chọn PDF/A-3a hoặc không đính kèm mã nguồn."

#: src/mathessible/error_messages.py:17
msgid "A font is not installed: choose another in the export's Layout tab."
msgstr "Một phông chữ chưa được cài đặt: hãy chọn phông khác trong thẻ Bố cục của phần xuất."

#: src/mathessible/error_messages.py:25
msgid ""
"Mathessible is not allowed to use this file or folder. Choose another place, or check its "
"permissions."
msgstr ""
"Mathessible không được phép dùng tệp hoặc thư mục này. Hãy chọn nơi khác hoặc kiểm tra quyền truy"
" cập."

#: src/mathessible/error_messages.py:28
msgid "The file or folder is not there any more."
msgstr "Tệp hoặc thư mục không còn ở đó nữa."

#: src/mathessible/error_messages.py:30
msgid "That is a folder, not a file."
msgstr "Đó là thư mục, không phải tệp."

#: src/mathessible/error_messages.py:32
msgid "The disk is full."
msgstr "Ổ đĩa đã đầy."

#: src/mathessible/error_messages.py:34
msgid "The file is not text in UTF-8, so Mathessible cannot read it."
msgstr "Tệp không phải văn bản UTF-8 nên Mathessible không đọc được."

#: src/mathessible/error_messages.py:36
msgid "Mathessible's native part (MathCAT and liblouis) is missing. Run scripts/bootstrap.sh."
msgstr "Thiếu phần gốc của Mathessible (MathCAT và liblouis). Hãy chạy scripts/bootstrap.sh."

#: src/mathessible/error_messages.py:43
#, python-brace-format
