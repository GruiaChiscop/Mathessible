#: src/mathessible/ui/settings_dialog.py:282
msgid "Write equations in LaTeX"
msgstr "以 LaTeX 撰寫方程式"

#: src/mathessible/ui/settings_dialog.py:287
msgid "Insert templates as control words (for example \\sum and \\sqrt instead of ∑ and √)"
msgstr "以控制字插入範本（例如 \\sum 和 \\sqrt，而不是 ∑ 和 √）"

#: src/mathessible/ui/settings_dialog.py:288
msgid "Insert templates as control words"
msgstr "以控制字插入範本"

#: src/mathessible/ui/settings_dialog.py:294
#, python-brace-format
msgid ""
"Decimal comma: 1,5 is a number and a set is written {1, 2, 3}; off: decimal point (3.14), and "
"{1,2,3} is a set"
msgstr "小數逗號：1,5 是一個數，集合寫成 {1, 2, 3}；關閉時：小數點（3.14），而 {1,2,3} 是集合"

#: src/mathessible/ui/settings_dialog.py:297
msgid "Decimal comma"
msgstr "小數逗號"

#: src/mathessible/ui/settings_dialog.py:302
msgid "Remove spaces that change nothing when saving the equation or switching to linear view"
msgstr "儲存方程式或切換到線性檢視時，移除不影響內容的空格"

#: src/mathessible/ui/settings_dialog.py:303
msgid "Remove extra spaces"
msgstr "移除多餘的空格"

#: src/mathessible/ui/settings_dialog.py:309
msgid "Math &AutoCorrect…"
msgstr "數學自動校正(&A)…"

#: src/mathessible/ui/settings_dialog.py:315
msgid ""
"Math AutoCorrect is one list, as in Word: the converter's control words, Mathessible's shortcuts "
"and your own entries, each one can be changed or deleted."
msgstr "數學自動校正是單一清單，與 Word 相同：轉換器的控制字、Mathessible 的捷徑及您自己的項目；每一項都可以變更或刪除。"

#: src/mathessible/ui/settings_dialog.py:321
msgid "Convert control words (for example \\alpha) when Space or punctuation is typed"
msgstr "輸入空格或標點符號時轉換控制字（例如 \\alpha）"

#: src/mathessible/ui/settings_dialog.py:322
msgid "Convert control words while typing"
msgstr "輸入時轉換控制字"

#: src/mathessible/ui/settings_dialog.py:328
msgid ""
"Convert symbol shortcuts (for example << or ->) as soon as they are typed, in equations and the "
"document"
msgstr "在方程式和文件中，一輸入符號捷徑（例如 << 或 ->）就立即轉換"

#: src/mathessible/ui/settings_dialog.py:330
msgid "Convert symbol shortcuts immediately"
msgstr "立即轉換符號捷徑"

#: src/mathessible/ui/settings_dialog.py:336
msgid ""
"Deleted AutoCorrect control words still show as their symbol (off: they stay the text typed, as "
"in Word)"
msgstr "從自動校正刪除的控制字仍顯示為其符號（關閉時：保留為輸入的文字，與 Word 相同）"

#: src/mathessible/ui/settings_dialog.py:338
msgid "Deleted AutoCorrect control words still show as their symbol"
msgstr "從自動校正刪除的控制字仍顯示為其符號"

#: src/mathessible/ui/settings_dialog.py:343
msgid "Use Math AutoCorrect in an equation's normal text (control words and shortcuts convert there too)"
msgstr "在方程式的一般文字中使用數學自動校正（控制字和捷徑在那裡也會轉換）"

#: src/mathessible/ui/settings_dialog.py:344
msgid "Use Math AutoCorrect in an equation's normal text"
msgstr "在方程式的一般文字中使用數學自動校正"

#: src/mathessible/ui/settings_dialog.py:350
msgid ""
"Use Math AutoCorrect in the document too, text and equations alike (as Word's rule outside math "
"regions)"
msgstr "在文件中也使用數學自動校正，文字和方程式皆適用（如同 Word 在數學區域外的規則）"

#: src/mathessible/ui/settings_dialog.py:352
msgid "Use Math AutoCorrect in the document"
msgstr "在文件中使用數學自動校正"

#: src/mathessible/ui/settings_dialog.py:362
msgid "Suggest control words while one is typed (Up/Down browse, Tab completes)"
msgstr "輸入控制字時提供建議（上/下鍵瀏覽，Tab 鍵補全）"

#: src/mathessible/ui/settings_dialog.py:363
msgid "Suggest control words while typing"
msgstr "輸入時建議控制字"

#: src/mathessible/ui/settings_dialog.py:368
msgid "Suggest commands while one is typed in the document (with Math AutoCorrect in the document)"
msgstr "在文件中輸入時也建議指令（文件中須啟用數學自動校正）"

#: src/mathessible/ui/settings_dialog.py:369
msgid "Suggest commands in the document"
msgstr "在文件中建議指令"

#: src/mathessible/ui/settings_dialog.py:375
msgid ""
"In a LaTeX document the suggestions are LaTeX's commands and the document's own, its environments"
" after \\begin{, its labels after \\ref{ and its citation keys after \\cite{."
msgstr "在 LaTeX 文件中，建議內容為 LaTeX 的指令與文件自訂的指令、\\begin{ 之後的環境、\\ref{ 之後的標籤，以及 \\cite{ 之後的引用鍵。"

#: src/mathessible/ui/settings_dialog.py:389
msgid "Build equations as you type (on Space or an operator, what is complete; the rest stays linear)"
msgstr "輸入時建構方程式（按空白鍵或輸入運算子時建構已完整的部分；其餘維持線性）"

#: src/mathessible/ui/settings_dialog.py:390
msgid "Build equations as you type"
msgstr "輸入時建構方程式"

#: src/mathessible/ui/settings_dialog.py:395
msgid "Say what was built while typing (for example, built fraction)"
msgstr "輸入時說出建構了什麼（例如：已建構分數）"

#: src/mathessible/ui/settings_dialog.py:396
msgid "Say what was built"
msgstr "說出建構了什麼"

#: src/mathessible/ui/settings_dialog.py:401
msgid "Open equations built (professional view), ready to navigate and type into"
msgstr "以已建構的形式開啟方程式（專業檢視），可直接瀏覽和輸入"

#: src/mathessible/ui/settings_dialog.py:402
msgid "Open equations built"
msgstr "以已建構的形式開啟方程式"

#: src/mathessible/ui/settings_dialog.py:407
msgid "Open a function's argument as soon as its parenthesis is closed (instead of on Space)"
msgstr "函數的括號一閉合就開啟其引數（而不是在按空白鍵時）"

#: src/mathessible/ui/settings_dialog.py:408
msgid "Open the argument on the closing parenthesis"
msgstr "在右括號處開啟引數"

#: src/mathessible/ui/settings_dialog.py:411
msgid "&Recognized Functions…"
msgstr "可辨識的函數(&R)…"

#: src/mathessible/ui/settings_dialog.py:417
msgid ""
"Space after a recognized function (sin, log, lim…) opens its argument, and it is navigated as "
"function name and argument, as in Word."
msgstr "在可辨識的函數（sin、log、lim…）後輸入空格會開啟其引數，並以函數名稱和引數的方式瀏覽，與 Word 相同。"

#: src/mathessible/ui/settings_dialog.py:425
msgid "Use linear navigation in exploration mode (F10; writing mode is always linear)"
msgstr "在探索模式中使用線性瀏覽（F10；書寫模式一律為線性）"

#: src/mathessible/ui/settings_dialog.py:426
msgid "Linear navigation in exploration mode"
msgstr "探索模式中的線性瀏覽"

#: src/mathessible/ui/settings_dialog.py:432
msgid ""
"Stop at the start and end of every structure (for example \"start fraction\", \"end numerator\") "
"and of the math"
msgstr "在每個結構（例如「開始分數」、「結束分子」）和數學的開頭與結尾停下"

#: src/mathessible/ui/settings_dialog.py:435
msgid "Stop at structure start and end"
msgstr "在結構的開頭與結尾停下"

#: src/mathessible/ui/settings_dialog.py:440
msgid "Stop at invisible operators (for example the invisible times in 3x)"
msgstr "在隱形運算子處停下（例如 3x 中隱形的乘號）"

#: src/mathessible/ui/settings_dialog.py:441
msgid "Stop at invisible operators"
msgstr "在隱形運算子處停下"

#: src/mathessible/ui/settings_dialog.py:446
msgid "Leave a structure automatically at its end (for example, from the numerator to the denominator)"
msgstr "在結構結尾時自動離開（例如從分子到分母）"

#: src/mathessible/ui/settings_dialog.py:447
msgid "Leave structures automatically"
msgstr "自動離開結構"

#: src/mathessible/ui/settings_dialog.py:453
msgid ""
"When enabled, the right arrow enters structures such as fractions automatically, so you can read "
"more of an expression without pressing Down."
msgstr "啟用時，右方向鍵會自動進入分數等結構，讓您不必按下方向鍵就能讀到更多運算式內容。"

#: src/mathessible/ui/settings_dialog.py:459
msgid "&Symbol dictionary (names spoken for symbols while typing)"
msgstr "符號字典(&S)（輸入時為符號說出的名稱）"

#: src/mathessible/ui/settings_dialog.py:461
msgid "Symbol dictionary"
msgstr "符號字典"

#: src/mathessible/ui/settings_dialog.py:464
msgid "&Import dictionary…"
msgstr "匯入字典(&I)…"

#: src/mathessible/ui/settings_dialog.py:466
msgid "&Download NVDA dictionaries…"
msgstr "下載 NVDA 字典(&D)…"

#: src/mathessible/ui/settings_dialog.py:477
msgid ""
"Any file in NVDA's symbols.dic format can be imported. NVDA's own dictionaries are downloaded "
"from the NVDA project on GitHub. The built equation is always read by MathCAT."
msgstr "可匯入任何採用 NVDA symbols.dic 格式的檔案。NVDA 本身的字典會從 GitHub 上的 NVDA 專案下載。已建構的方程式一律由 MathCAT 朗讀。"

#: src/mathessible/ui/settings_dialog.py:483
msgid "Say symbols MathCAT does not know by their Unicode name (for example, alchemical symbol for air)"
msgstr "以 Unicode 名稱說出 MathCAT 不認識的符號（例如 alchemical symbol for air）"

#: src/mathessible/ui/settings_dialog.py:484
msgid "Name unknown symbols"
msgstr "說出不明符號的名稱"

#: src/mathessible/ui/settings_dialog.py:489
msgid "&Braille code (the braille strip under the equation)"
msgstr "點字碼(&B)（方程式下方的點字列）"

#: src/mathessible/ui/settings_dialog.py:491
msgid "Braille code"
msgstr "點字碼"

#: src/mathessible/ui/settings_dialog.py:495
msgid "Braille si&gns…"
msgstr "點字符號(&G)…"

#: src/mathessible/ui/settings_dialog.py:503
msgid ""
"Braille signs are your own braille for symbols in the code chosen above, for symbols it has no "
"sign for, or to replace its own."
msgstr "點字符號是您為上方所選點字碼中的符號自訂的點字，用於該點字碼沒有對應符號的符號，或取代它自己的符號。"

#: src/mathessible/ui/settings_dialog.py:507
msgid "BRF export (its dialog can change them for one file)"
msgstr "BRF 匯出（其對話方塊可針對單一檔案變更）"

#: src/mathessible/ui/settings_dialog.py:528
msgid "The system's"
msgstr "系統語言"

#: src/mathessible/ui/settings_dialog.py:530
msgid "&Interface"
msgstr "介面(&I)"

#: src/mathessible/ui/settings_dialog.py:530
msgid "Interface language"
msgstr "介面語言"

#: src/mathessible/ui/settings_dialog.py:532
msgid "The interface's"
msgstr "與介面相同"

#: src/mathessible/ui/settings_dialog.py:534
msgid "&Speech of equations"
msgstr "方程式語音(&S)"

#: src/mathessible/ui/settings_dialog.py:534
msgid "Speech language"
msgstr "語音語言"

#: src/mathessible/ui/settings_dialog.py:540
msgid ""
"The interface changes when Mathessible starts again; the speech of equations at once. These are "
"MathCAT's languages. Translations other than English are drafts that a native speaker has yet to "
"review."
msgstr "介面會在下次啟動 Mathessible 時變更；方程式的語音則立即變更。這些是 MathCAT 的語言。英文以外的翻譯皆為草稿，尚待母語人士審閱。"

#: src/mathessible/ui/settings_dialog.py:557
msgid "Default &author"
msgstr "預設作者(&A)"

#: src/mathessible/ui/settings_dialog.py:557
msgid "Default author"
msgstr "預設作者"

#: src/mathessible/ui/settings_dialog.py:562
msgid ""
"These are the defaults for every PDF; the export's dialog can change them for one PDF, and holds "
"the title, watermark and passwords, which are never kept."
msgstr "這些是每個 PDF 的預設值；匯出的對話方塊可針對單一 PDF 變更，並包含標題、浮水印和密碼，這些絕不保留。"

#: src/mathessible/ui/settings_dialog.py:696
msgid "Import a symbol dictionary"
msgstr "匯入符號字典"

#: src/mathessible/ui/settings_dialog.py:697
msgid "NVDA symbol dictionaries"
msgstr "NVDA 符號字典"

#: src/mathessible/ui/settings_dialog.py:706
msgid "Import failed"
msgstr "匯入失敗"

#: src/mathessible/ui/settings_dialog.py:713
msgid "Listing NVDA's languages…"
msgstr "正在取得 NVDA 的語言清單…"

#: src/mathessible/ui/settings_dialog.py:718
msgid "Choose the languages to download (Space checks one)."
msgstr "選擇要下載的語言（按空白鍵勾選）。"

#: src/mathessible/ui/settings_dialog.py:719 src/mathessible/ui/settings_dialog.py:752
#: src/mathessible/ui/settings_dialog.py:757 src/mathessible/ui/settings_dialog.py:778
msgid "Download NVDA dictionaries"
msgstr "下載 NVDA 字典"

#: src/mathessible/ui/settings_dialog.py:730
#, python-brace-format
msgid "Downloading {count} dictionary…"
msgid_plural "Downloading {count} dictionaries…"
msgstr[0] "正在下載 {count} 個字典…"

#: src/mathessible/ui/settings_dialog.py:745
#, python-brace-format
msgid "{count} dictionary downloaded."
msgid_plural "{count} dictionaries downloaded."
msgstr[0] "已下載 {count} 個字典。"

#: src/mathessible/ui/settings_dialog.py:749
#, python-brace-format
msgid "NVDA has no symbol dictionary for: {languages}."
msgstr "NVDA 沒有以下語言的符號字典：{languages}。"

#: src/mathessible/ui/settings_dialog.py:777
#, python-brace-format
msgid "The download failed: {error}"
msgstr "下載失敗：{error}"

#: src/mathessible/ui/settings_dialog.py:797 src/mathessible/ui/settings_dialog.py:798
#: src/mathessible/ui/settings_dialog.py:835
msgid "Settings"
msgstr "設定"

#: src/mathessible/ui/settings_dialog.py:836
msgid "Settings dialog"
msgstr "設定對話方塊"

#: src/mathessible/ui/status_line.py:26
msgid "Status"
msgstr "狀態"

#: src/mathessible/ui/symbol_dialog.py:34
msgid "Insert Symbol"
msgstr "插入符號"

#: src/mathessible/ui/symbol_dialog.py:35
msgid "Insert symbol dialog"
msgstr "插入符號對話方塊"

#: src/mathessible/ui/symbol_dialog.py:41
msgid "&Search (control word, symbol or name)"
msgstr "搜尋(&S)（控制字、符號或名稱）"

#: src/mathessible/ui/symbol_dialog.py:43
msgid "Search symbols"
msgstr "搜尋符號"

#: src/mathessible/ui/symbol_dialog.py:44
msgid "&Matches"
msgstr "符合項目(&M)"

#: src/mathessible/ui/symbol_dialog.py:46
msgid "Matching symbols"
msgstr "符合的符號"

