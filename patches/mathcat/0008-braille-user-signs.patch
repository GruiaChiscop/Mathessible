+    /// MateX: read the user's braille signs (`set_braille_user_signs`) into the short table just read,
+    /// so each one replaces the braille code's own sign for that character.
+    fn read_user_braille_signs(&self) -> Result<()> {
+        let signs = BRAILLE_USER_SIGNS.with(|signs| signs.borrow().clone());
+        if signs.trim().is_empty() {
+            return Ok( () );
+        }
+        let path = PathBuf::from("MateX user braille signs");
+        let build_fn = |unicode_def_list: &Yaml| {
+            let Some(unicode_defs) = unicode_def_list.as_vec() else {
+                bail!("The user's braille signs do not begin with an array");
+            };
+            for unicode_def in unicode_defs {
+                UnicodeDef::build(unicode_def, &path, self, true)?;
+            }
+            return Ok(vec![]);
+        };
+        compile_rule(&signs, build_fn)?;
+        return Ok( () );
+    }
