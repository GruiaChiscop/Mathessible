+
+/// MateX: set the user's own braille signs (unicode.yaml entries, ` - "⊏": [t: "⠈⠸⠣"]`), read after
+/// the braille code's short table so they replace its signs; "" clears them. Braille reloads on a change.
+pub fn set_braille_user_signs(signs: &str) {
+    let changed = BRAILLE_USER_SIGNS.with(|current| {
+        if *current.borrow() == signs {
+            return false;
+        }
+        *current.borrow_mut() = signs.to_string();
+        return true;
+    });
+    if changed {
+        invalidate_braille_caches();
+    }
+}
