 }
+// The math alphabets of LaTeX, as mathStyles names: their letters and digits become
+// the Unicode math alphanumerics (\mathbb{R} is ℝ, \mathbf{\frac{a}{b}} the fraction of
+// 𝐚 and 𝐛), \mathrm letters upright text. Control words and \text{...} are kept.
+const texMathAlphabets = {
+    'mathbb': 'Bbb', 'mathbf': 'mbf', 'mathit': 'mit', 'mathbfit': 'mbfit', 'mathcal': 'mscr',
+    'mathscr': 'mscr', 'mathfrak': 'mfrak', 'mathsf': 'msans', 'mathtt': 'mtt', 'mathrm': 'mup',
+    'boldsymbol': 'boldsymbol', 'bm': 'boldsymbol',
+}
+// amsmath's \boldsymbol (and bm's \bm) of an alphabet: \boldsymbol{\mathcal{X}} is bold script.
+const texBoldAlphabets = {'mscr': 'mbfscr', 'mfrak': 'mbffrak', 'msans': 'mbfsans', 'mit': 'mbfit'}
+
+function texStyledChar(ch, style) {
+    // \boldsymbol is LaTeX's bold of what is there: letters, lowercase Greek, \partial and \nabla
+    // bold italic, digits and uppercase Greek bold upright
+    if (style == 'boldsymbol')
+        style = /[0-9\u0391-\u03A9]/.test(ch) ? 'mbf' : 'mbfit'
+    return getMathAlphanumeric(ch, style)
+}
+
+function texClosingBrace(tex, i) {
+    // Offset of the '}' closing the '{' before offset i (escaped braces skipped), or -1
+    for (let depth = 1; i < tex.length; i++) {
+        if (tex[i] == '\\')
+            i++
+        else if (tex[i] == '{')
+            depth++
+        else if (tex[i] == '}' && !--depth)
+            return i
+    }
+    return -1
+}
+
+function texStyled(tex, style) {
+    // tex's letters and digits in the math alphabet style; control words and texts kept
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^\\(?:text|mbox|operatorname)\s*\{/.exec(tex.substring(i))
+        if (m) {
+            let j = texClosingBrace(tex, i + m[0].length)
+            if (j == -1)
+                return ret + tex.substring(i)
+            ret += tex.substring(i, j + 1)
+            i = j + 1
+            continue
+        }
+        m = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+        if (m) {
+            // A Greek letter's control word (\mathbf{\Gamma}, \boldsymbol{\alpha}) is its math alphanumeric
+            let symbol = style != 'mup' && /^\\[A-Za-z]+$/.test(m[0]) ? resolveCW(m[0]) : ''
+            ret += /^[\u0391-\u03F5\u2202\u2207]$/.test(symbol) ? texStyledChar(symbol, style) : m[0]
+            i += m[0].length
+            continue
+        }
+        m = /^[A-Za-z0-9]+/.exec(tex.substring(i))
+        if (m) {
+            ret += style == 'mup' ? '"' + m[0] + '"'
+                : Array.from(m[0], ch => texStyledChar(ch, style)).join('')
+            i += m[0].length
+            continue
+        }
+        if (tex[i] != ' ' || style != 'mup')
+            ret += tex[i]
+        i++
+    }
+    return ret
+}
+
+function TeXMathAlphabets(tex) {
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^\\(math(?:bb|bfit|bf|it|cal|scr|frak|sf|tt|rm)|boldsymbol|bm)(?![A-Za-z])\s*/.exec(tex.substring(i))
+        if (!m) {
+            let cw = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+            let n = cw ? cw[0].length : 1
+            ret += tex.substring(i, i + n)
+            i += n
+            continue
+        }
+        let style = texMathAlphabets[m[1]]
+        let j = i + m[0].length
+        if (tex[j] == '{') {
+            let k = texClosingBrace(tex, j + 1)
+            if (k == -1)
+                return ret + tex.substring(i)
+            let argument = tex.substring(j + 1, k)
+            let inner = /^\s*\\(math(?:cal|scr|frak|sf|it))\s*\{/.exec(argument)
+            if (style == 'boldsymbol' && inner && texClosingBrace(argument, inner[0].length) == argument.trimEnd().length - 1) {
+                style = texBoldAlphabets[texMathAlphabets[inner[1]]]
+                argument = argument.substring(inner[0].length, argument.trimEnd().length - 1)
+            }
+            ret += texStyled(TeXMathAlphabets(argument), style)
+            if (/\\[A-Za-z]+$/.test(ret) && /[A-Za-z]/.test(tex[k + 1] || ''))
+                ret += ' '                  // \mathrm{\mu}y: the control word ends before the y
+            i = k + 1
+        } else if (/[A-Za-z0-9]/.test(tex[j] || '')) {
+            ret += texStyled(tex[j], style)
+            i = j + 1
+        } else if (tex[j] == '\\' && /^\\[A-Za-z]+/.test(tex.substring(j))) {
+            // A control word as the argument: \mathbf \Gamma, as MathCAT writes bold Greek
+            let cw = /^\\[A-Za-z]+/.exec(tex.substring(j))[0]
+            ret += texStyled(cw, style)
+            i = j + cw.length
+        } else {
+            ret += m[0]
+            i = j
+        }
+    }
+    return ret
+}
+
+// Plain TeX's and Word's matrices, \pmatrix{a&b\\c&d} (rows ended by \\ or \cr), as
+// the environments TeX2UMath reads: \begin{pmatrix}a&b\\c&d\end{pmatrix}.
+function TeXMatrixCommands(tex) {
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^\\([pbvVB]?matrix)\s*\{/.exec(tex.substring(i))
+        if (!m) {
+            let cw = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+            let n = cw ? cw[0].length : 1
+            ret += tex.substring(i, i + n)
+            i += n
+            continue
+        }
+        let j = texClosingBrace(tex, i + m[0].length)
+        if (j == -1)
+            return ret + tex.substring(i)
+        let body = TeXMatrixCommands(tex.substring(i + m[0].length, j)).replace(/\\cr(?![A-Za-z])/g, '\\\\')
+        ret += '\\begin{' + m[1] + '}' + body + '\\end{' + m[1] + '}'
+        i = j + 1
+    }
+    return ret
+}
+
+// The norm bars: \| and amsmath's \lVert, \rVert are \Vert (U+2016), whose name the control-word
+// table has; \lvert and \rvert are |. Read token by token, so that \\ (a line break) is left.
+const texNormDelimiters = {'\\|': '\\Vert ', '\\lVert': '\\Vert ', '\\rVert': '\\Vert ', '\\lvert': '| ', '\\rvert': '| '}
+
+function TeXNormDelimiters(tex) {
+    return tex.replace(/\\(?:[A-Za-z]+|.)/g, cw => texNormDelimiters[cw] ?? cw)
+}
+
+// LaTeX's spaces as UnicodeMath's (uniSpaces, in 18ths of an em): \, thin (3), \: and \> medium (4),
+// \; thick (5), \ and ~ an interword space (6), \enspace (9), \qquad two quads. \;, \: and \>
+// came out as punctuation, \ and \qquad as errors, ~ as \sim, and \! as a factorial: UnicodeMath has
+// no negative space, so \! and the negative spaces are left out.
+const texSpaces = {
+    '\\!': '', '\\negthinspace': '', '\\negmedspace': '', '\\negthickspace': '',
+    '\\,': '\u2009 ', '\\thinspace': '\u2009 ', '\\:': '\u205F ', '\\>': '\u205F ', '\\medspace': '\u205F ',
+    '\\;': '\u2005 ', '\\thickspace': '\u2005 ', '\\ ': '\u2004 ', '~': '\u2004 ', '\\enspace': '\u2002 ',
+    '\\qquad': '\u2003\u2003 ',
+}
+
+function TeXSpaces(tex) {
+    return tex.replace(/\\(?:[A-Za-z]+|.)|~/g, cw => texSpaces[cw] ?? cw)
+}
+
+// amssymb's and LaTeX's symbols that the control-word table (Word's) lacks, or has with another
+// meaning (\implies an arrow, \succeq Word's ≽, \Re and \Im functions): \leqslant came out as text.
+const texSymbols = {
+    'backprime': '‵', 'barwedge': '⊼', 'bigstar': '★', 'bigtriangledown': '▽', 'blacksquare': '■',
+    'blacktriangle': '▴', 'blacktriangledown': '▾', 'blacktriangleleft': '◀', 'blacktriangleright': '▶',
+    'cdotp': '·', 'circledR': '®', 'copyright': '©', 'doublebarwedge': '⩞', 'eqsim': '≂', 'eqslantgtr': '⪖',
+    'eqslantless': '⪕', 'Finv': 'Ⅎ', 'flat': '♭', 'Game': '⅁', 'geqslant': '⩾', 'gnapprox': '⪊', 'gneq': '⪈',
+    'gtrapprox': '⪆', 'gtreqqless': '⪌', 'hslash': 'ℏ', 'iff': '⟺', 'Im': 'ℑ', 'impliedby': '⟸', 'implies': '⟹',
+    'leftrightsquigarrow': '↭', 'lgroup': '⟮', 'lmoustache': '⎰', 'leqslant': '⩽', 'lessapprox': '⪅', 'lesseqqgtr': '⪋', 'llcorner': '⌞',
+    'lnapprox': '⪉', 'lneq': '⪇', 'lrcorner': '⌟', 'measuredangle': '∡', 'mho': '℧', 'mid': '∣',
+    'natural': '♮', 'ngtr': '≯', 'oslash': '⊘', 'P': '¶', 'pounds': '£', 'precapprox': '⪷', 'preceq': '⪯',
+    'precnapprox': '⪹', 'precneqq': '⪵', 'Re': 'ℜ', 'rgroup': '⟯', 'rightsquigarrow': '⇝', 'rmoustache': '⎱', 'S': '§', 'sharp': '♯',
+    'sphericalangle': '∢', 'square': '□', 'subseteqq': '⫅', 'subsetneqq': '⫋', 'succapprox': '⪸',
+    'succeq': '⪰', 'succnapprox': '⪺', 'succneqq': '⪶', 'supseteqq': '⫆', 'supsetneqq': '⫌',
+    'therefore': '∴', 'triangledown': '▿', 'triangleq': '≜', 'ulcorner': '⌜', 'urcorner': '⌝',
+    'varnothing': '∅', 'vartriangle': '▵', 'veebar': '⊻', 'yen': '¥',
+}
+
+// \mathbin{x}, \mathrel{x} and the other math classes only change LaTeX's spacing: their argument
+// is kept (they came out as text). \not\lesssim and \not= are the negated symbols themselves (≴, ≠),
+// since TeX2UMath's / for \not made x/≲ a fraction.
+function TeXClassesAndNegations(tex) {
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^\\math(?:bin|rel|ord|op|punct|open|close|inner)\s*\{/.exec(tex.substring(i))
+        let k = m ? texClosingBrace(tex, i + m[0].length) : -1
+        if (k != -1) {
+            ret += TeXClassesAndNegations(tex.substring(i + m[0].length, k)) + ' '
+            i = k + 1
+            continue
+        }
+        m = /^\\not(?![A-Za-z])\s*(\\[A-Za-z]+|[^\s\\{}])/.exec(tex.substring(i))
+        if (m) {
+            let ch = m[1][0] == '\\' ? texSymbols[m[1].substring(1)] ?? resolveCW(m[1]) : m[1]
+            let negated = ch && [...ch].length == 1 ? (ch + '\u0338').normalize('NFC') : ''
+            if (negated && [...negated].length == 1) {
+                ret += negated + ' '
+                i += m[0].length
+                continue
+            }
+        }
+        let cw = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+        let n = cw ? cw[0].length : 1
+        ret += tex.substring(i, i + n)
+        i += n
+    }
+    return ret
+}
+
+function TeXSymbols(tex) {
+    return tex.replace(/\\[A-Za-z]+/g, cw => texSymbols[cw.substring(1)] ?? cw)
+}
+
+// Characters UnicodeMath builds structures with (/ and ⊘ a fraction, ■ a matrix, ▭ a box, ┴ an
+// overscript, ⟌ a long division, ⏞ a brace above...), typed or from \oslash, \blacksquare, \square,
+// \mid, are quoted (\⊘): in LaTeX they
+// are symbols, a/b a slash (\frac is LaTeX's fraction). A \text{...} is left as it is.
+const texQuoted = '/⊘∣□■▭█¦▒┴┬⟌⍁⟡⇳▢◯○☁⫷⫸⎴⎵⏜⏝⏞⏟⏠⏡⟮⟯⎰⎱'
+
+function TeXQuotedOperators(tex) {
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^\\(?:text|mbox|operatorname)\s*\{/.exec(tex.substring(i))
+        if (m) {
+            let k = texClosingBrace(tex, i + m[0].length)
+            let end = k == -1 ? tex.length : k + 1
+            ret += tex.substring(i, end)
+            i = end
+            continue
+        }
+        m = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+        if (m) {
+            ret += m[0]
+            i += m[0].length
+            continue
+        }
+        ret += texQuoted.includes(tex[i]) ? '\\' + tex[i] : tex[i]
+        i++
+    }
+    return ret
+}
+
+// A script whose argument is a command with a group of its own (x^\text{a}, x_\mathrm{max}): the
+// command and its group are the script, as in LaTeX (TeX2UMath took the command alone).
+function TeXScriptCommands(tex) {
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^([_^])\s*(\\[A-Za-z]+\s*\{)/.exec(tex.substring(i))
+        let k = m ? texClosingBrace(tex, i + m[0].length) : -1
+        if (k != -1) {
+            ret += m[1] + '{' + TeXScriptCommands(tex.substring(i + m[1].length, k + 1)) + '}'
+            i = k + 1
+            continue
+        }
+        let cw = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+        let n = cw ? cw[0].length : 1
+        ret += tex.substring(i, i + n)
+        i += n
+    }
+    return ret
+}
+
+// amsmath's \overset{a}{b}, \underset{a}{b} and \stackrel{a}{b} as UnicodeMath's b┴a and b┬a (they
+// came out as text): Mathessible's MathCAT writes ≝, ≟ and the Insert menu's arrows with them.
+function texArgument(tex, i) {
+    // The argument at offset i (spaces skipped): a group's text or one token, and where it ends
+    while (tex[i] == ' ')
+        i++
+    if (tex[i] == '{') {
+        let k = texClosingBrace(tex, i + 1)
+        return k == -1 ? null : [tex.substring(i + 1, k), k + 1]
+    }
+    let m = /^\\(?:[A-Za-z]+|.)|^[^\s{}]/.exec(tex.substring(i))
+    return m ? [m[0], i + m[0].length] : null
+}
+
+function TeXStackCommands(tex) {
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^\\(overset|underset|stackrel)(?![A-Za-z])/.exec(tex.substring(i))
+        let above = m && texArgument(tex, i + m[0].length)
+        let base = above && texArgument(tex, above[1])
+        if (!base) {
+            let cw = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+            let n = cw ? cw[0].length : 1
+            ret += tex.substring(i, i + n)
+            i += n
+            continue
+        }
+        let script = TeXStackCommands(above[0])
+        // Parentheses group both (UnicodeMath's invisible 〖〗, which {} would be, cannot be a base)
+        ret += '(' + TeXStackCommands(base[0]) + ')' + (m[1] == 'underset' ? '┬' : '┴') + '(' + script + ') '
+        i = base[1]
+    }
+    return ret
+}
+
+// \text{...} and \mbox{...} as UnicodeMath's quoted text, "...": TeX2UMath's ⓣ(...) did not build with
+// parentheses inside (\text{a (f)}), kept LaTeX's escapes (\&, \_) and made a lone letter (\text{a})
+// an upright variable. Text's escapes are its characters again.
+const texTextEscapes = {
+    '\\%': '%', '\\&': '&', '\\#': '#', '\\$': '$', '\\_': '_', '\\{': '{', '\\}': '}', '\\ ': ' ', '~': '\u00A0',
+    '\\textasciitilde{}': '~', '\\textasciicircum{}': '^',
+}
+
+function TeXTexts(tex) {
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^\\(?:text|mbox|textrm)\s*\{/.exec(tex.substring(i))
+        let k = m ? texClosingBrace(tex, i + m[0].length) : -1
+        if (k == -1) {
+            let cw = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+            let n = cw ? cw[0].length : 1
+            ret += tex.substring(i, i + n)
+            i += n
+            continue
+        }
+        let raw = tex.substring(i + m[0].length, k)
+        if (/(?<!\\)\$|\\(?!text(?:asciitilde|asciicircum)\{\}|[%&#$_{} ])/.test(raw)) {
+            ret += tex.substring(i, k + 1)  // Math or commands inside: left to TeX2UMath
+        } else {
+            // % and $ quoted again for TeX2UMath (a comment, math), " for UnicodeMath
+            let text = raw.replace(/\\text(?:asciitilde|asciicircum)\{\}|\\[%&#$_{} ]|~/g, e => texTextEscapes[e])
+            ret += '"' + text.replace(/[%$"]/g, c => '\\' + c) + '"'
+        }
+        i = k + 1
+    }
+    return ret
+}
+
+// A document's numbering and cross-reference commands, which are not math: \label{...},
+// \nonumber and \notag (in an equation or align environment) are left out. An equation's own number,
+// \tag{1}, is UnicodeMath's equation number, #(1), shown and read with it; in an environment's rows
+// (several \tag), it is left out too.
+function TeXDocumentCommands(tex) {
+    let tags = []
+    tex = tex.replace(/\\tag\*?\s*\{([^{}]*)\}/g, (all, label) => { tags.push(label); return '' })
+    tex = tex.replace(/\\label\s*\{[^{}]*\}|\\(?:nonumber|notag)(?![A-Za-z])/g, '')
+    if (tags.length == 1 && !/\\\\|\\begin/.test(tex))
+        tex = tex.trimEnd() + '#(' + tags[0].trim() + ')'
+    return tex
+}
+
 function TeX2UnicodeMath(tex) {
+    tex = TeXMathAlphabets(TeXMatrixCommands(TeXTexts(TeXDocumentCommands(TeXStackCommands(TeXQuotedOperators(TeXSymbols(TeXClassesAndNegations(TeXSpaces(TeXScriptCommands(TeXNormDelimiters(tex)))))))))))
     // Pass 1: Convert control words in tex to Unicode symbols or strings
     let cwPrev = ''
     let macrosEnabled = ummlConfig && ummlConfig.texMacros
