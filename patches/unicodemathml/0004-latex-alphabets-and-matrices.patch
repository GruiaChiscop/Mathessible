+// The math alphabets of LaTeX, as mathStyles names: their letters and digits become
+// the Unicode math alphanumerics (\mathbb{R} is ℝ, \mathbf{\frac{a}{b}} the fraction of
+// 𝐚 and 𝐛), \mathrm letters upright text. Control words and \text{...} are kept.
+const texMathAlphabets = {
+    'mathbb': 'Bbb', 'mathbf': 'mbf', 'mathit': 'mit', 'mathbfit': 'mbfit', 'mathcal': 'mscr',
+    'mathscr': 'mscr', 'mathfrak': 'mfrak', 'mathsf': 'msans', 'mathtt': 'mtt', 'mathrm': 'mup',
+    'boldsymbol': 'boldsymbol', 'bm': 'boldsymbol',
+}
+// amsmath's \boldsymbol (and bm's \bm) of an alphabet: \boldsymbol{\mathcal{X}} is bold script.
+const texBoldAlphabets = {'mscr': 'mbfscr', 'mfrak': 'mbffrak', 'msans': 'mbfsans', 'mit': 'mbfit'}
+
+function texStyledChar(ch, style) {
+    // \boldsymbol is LaTeX's bold of what is there: letters, lowercase Greek, \partial and \nabla
+    // bold italic, digits and uppercase Greek bold upright
+    if (style == 'boldsymbol')
+        style = /[0-9\u0391-\u03A9]/.test(ch) ? 'mbf' : 'mbfit'
+    return getMathAlphanumeric(ch, style)
+}
+
+function texClosingBrace(tex, i) {
+    // Offset of the '}' closing the '{' before offset i (escaped braces skipped), or -1
+    for (let depth = 1; i < tex.length; i++) {
+        if (tex[i] == '\\')
+            i++
+        else if (tex[i] == '{')
+            depth++
+        else if (tex[i] == '}' && !--depth)
+            return i
+    }
+    return -1
+}
+
+function texStyled(tex, style) {
+    // tex's letters and digits in the math alphabet style; control words and texts kept
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^\\(?:text|mbox|operatorname)\s*\{/.exec(tex.substring(i))
+        if (m) {
+            let j = texClosingBrace(tex, i + m[0].length)
+            if (j == -1)
+                return ret + tex.substring(i)
+            ret += tex.substring(i, j + 1)
+            i = j + 1
+            continue
+        }
+        m = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+        if (m) {
+            // A Greek letter's control word (\mathbf{\Gamma}, \boldsymbol{\alpha}) is its math alphanumeric
+            let symbol = style != 'mup' && /^\\[A-Za-z]+$/.test(m[0]) ? resolveCW(m[0]) : ''
+            ret += /^[\u0391-\u03F5\u2202\u2207]$/.test(symbol) ? texStyledChar(symbol, style) : m[0]
+            i += m[0].length
+            continue
+        }
+        m = /^[A-Za-z0-9]+/.exec(tex.substring(i))
+        if (m) {
+            ret += style == 'mup' ? '"' + m[0] + '"'
+                : Array.from(m[0], ch => texStyledChar(ch, style)).join('')
+            i += m[0].length
+            continue
+        }
+        if (tex[i] != ' ' || style != 'mup')
+            ret += tex[i]
+        i++
+    }
+    return ret
+}
+
+function TeXMathAlphabets(tex) {
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^\\(math(?:bb|bfit|bf|it|cal|scr|frak|sf|tt|rm)|boldsymbol|bm)(?![A-Za-z])\s*/.exec(tex.substring(i))
+        if (!m) {
+            let cw = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+            let n = cw ? cw[0].length : 1
+            ret += tex.substring(i, i + n)
+            i += n
+            continue
+        }
+        let style = texMathAlphabets[m[1]]
+        let j = i + m[0].length
+        if (tex[j] == '{') {
+            let k = texClosingBrace(tex, j + 1)
+            if (k == -1)
+                return ret + tex.substring(i)
+            let argument = tex.substring(j + 1, k)
+            let inner = /^\s*\\(math(?:cal|scr|frak|sf|it))\s*\{/.exec(argument)
+            if (style == 'boldsymbol' && inner && texClosingBrace(argument, inner[0].length) == argument.trimEnd().length - 1) {
+                style = texBoldAlphabets[texMathAlphabets[inner[1]]]
+                argument = argument.substring(inner[0].length, argument.trimEnd().length - 1)
+            }
+            ret += texStyled(TeXMathAlphabets(argument), style)
+            i = k + 1
+        } else if (/[A-Za-z0-9]/.test(tex[j] || '')) {
+            ret += texStyled(tex[j], style)
+            i = j + 1
+        } else if (tex[j] == '\\' && /^\\[A-Za-z]+/.test(tex.substring(j))) {
+            // A control word as the argument: \mathbf \Gamma, as MathCAT writes bold Greek
+            let cw = /^\\[A-Za-z]+/.exec(tex.substring(j))[0]
+            ret += texStyled(cw, style)
+            i = j + cw.length
+        } else {
+            ret += m[0]
+            i = j
+        }
+    }
+    return ret
+}
+
+// Plain TeX's and Word's matrices, \pmatrix{a&b\\c&d} (rows ended by \\ or \cr), as
+// the environments TeX2UMath reads: \begin{pmatrix}a&b\\c&d\end{pmatrix}.
+function TeXMatrixCommands(tex) {
+    let ret = ''
+    for (let i = 0; i < tex.length;) {
+        let m = /^\\([pbvVB]?matrix)\s*\{/.exec(tex.substring(i))
+        if (!m) {
+            let cw = /^\\(?:[A-Za-z]+|.)/.exec(tex.substring(i))
+            let n = cw ? cw[0].length : 1
+            ret += tex.substring(i, i + n)
+            i += n
+            continue
+        }
+        let j = texClosingBrace(tex, i + m[0].length)
+        if (j == -1)
+            return ret + tex.substring(i)
+        let body = TeXMatrixCommands(tex.substring(i + m[0].length, j)).replace(/\\cr(?![A-Za-z])/g, '\\\\')
+        ret += '\\begin{' + m[1] + '}' + body + '\\end{' + m[1] + '}'
+        i = j + 1
+    }
+    return ret
+}
+
+// The norm bars: \| and amsmath's \lVert, \rVert are \Vert (U+2016), whose name the control-word
+// table has; \lvert and \rvert are |. Read token by token, so that \\ (a line break) is left.
+const texNormDelimiters = {'\\|': '\\Vert ', '\\lVert': '\\Vert ', '\\rVert': '\\Vert ', '\\lvert': '| ', '\\rvert': '| '}
+
+function TeXNormDelimiters(tex) {
+    return tex.replace(/\\(?:[A-Za-z]+|.)/g, cw => texNormDelimiters[cw] ?? cw)
+}
+
+// LaTeX's spaces as UnicodeMath's (uniSpaces, in 18ths of an em): \, thin (3), \: and \> medium (4),
+// \; thick (5), \ and ~ an interword space (6), \enspace (9), \qquad two quads. \;, \: and \>
+// came out as punctuation, \ and \qquad as errors, ~ as \sim, and \! as a factorial: UnicodeMath has
+// no negative space, so \! and the negative spaces are left out.
+const texSpaces = {
+    '\\!': '', '\\negthinspace': '', '\\negmedspace': '', '\\negthickspace': '',
+    '\\,': '\u2009 ', '\\thinspace': '\u2009 ', '\\:': '\u205F ', '\\>': '\u205F ', '\\medspace': '\u205F ',
+    '\\;': '\u2005 ', '\\thickspace': '\u2005 ', '\\ ': '\u2004 ', '~': '\u2004 ', '\\enspace': '\u2002 ',
+    '\\qquad': '\u2003\u2003 ',
+}
+
+function TeXSpaces(tex) {
+    return tex.replace(/\\(?:[A-Za-z]+|.)|~/g, cw => texSpaces[cw] ?? cw)
+}
+
+// A document's numbering and cross-reference commands, which are not math: \label{...},
+// \tag{...} and \nonumber or \notag (in an equation or align environment) are left out.
+function TeXDocumentCommands(tex) {
+    return tex.replace(/\\(?:label|tag\*?)\s*\{[^{}]*\}|\\(?:nonumber|notag)(?![A-Za-z])/g, '')
+}
+
 function TeX2UnicodeMath(tex) {
+    tex = TeXMathAlphabets(TeXMatrixCommands(TeXDocumentCommands(TeXSpaces(TeXNormDelimiters(tex)))))
     // Pass 1: Convert control words in tex to Unicode symbols or strings
     let cwPrev = ''
     let macrosEnabled = ummlConfig && ummlConfig.texMacros
