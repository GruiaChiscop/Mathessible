+// The math alphabets of LaTeX, as mathStyles names: their letters and digits become
+// the Unicode math alphanumerics (\mathbb{R} is ℝ), \mathrm text upright. Only a
+// simple argument, one character or letters, digits and spaces in braces.
+const texMathAlphabets = {
+    'mathbb': 'Bbb', 'mathbf': 'mbf', 'mathit': 'mit', 'mathbfit': 'mbfit', 'mathcal': 'mscr',
+    'mathscr': 'mscr', 'mathfrak': 'mfrak', 'mathsf': 'msans', 'mathtt': 'mtt', 'mathrm': 'mup',
+}
+
+function TeXMathAlphabets(tex) {
+    return tex.replace(/\\(math(?:bb|bfit|bf|it|cal|scr|frak|sf|tt|rm))(?![A-Za-z])\s*(?:\{([A-Za-z0-9 ]*)\}|([A-Za-z0-9]))/g,
+        (match, name, braced, single) => {
+            const style = texMathAlphabets[name]
+            const chars = (braced != undefined ? braced : single).replace(/ /g, '')
+            if (!chars)
+                return match
+            if (style == 'mup')
+                return '"' + chars + '"'
+            return Array.from(chars, ch => getMathAlphanumeric(ch, style)).join('')
+        })
+}
+
 function TeX2UnicodeMath(tex) {
+    tex = TeXMathAlphabets(tex)
