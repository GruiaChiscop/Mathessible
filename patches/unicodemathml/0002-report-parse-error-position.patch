     debugGroup(unicodemath);
     selanchor = selfocus = null
+    ummlParseError = null
+    let mathessibleLeading = unicodemath.length - unicodemath.trimStart().length
     let k = unicodemath.length
     if (unicodemath[0] == ' ' || unicodemath[k - 1] == ' ') {
         unicodemath = unicodemath.trim()
